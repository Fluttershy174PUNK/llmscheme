# Admin bootstrapped on first run when the db is empty. The compose file
# refuses to start without ADMIN_PASSWORD.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me

# Origins allowed to call /mcp from a browser. Empty = same-origin only.
# Set this when an MCP client lives on a different host.
ORIGIN_ALLOWLIST=

# Quotas (MB). 64 MB lightdb holds ~thousands of users; 8 MB body is enough
# for a fully built scheme with all of its zones/edges.
DB_QUOTA_MB=64
MAX_BODY_MB=8

# Session lifetime, days. 30 by default; the active token also lives in a
# HttpOnly cookie so a closing browser doesn't keep it alive forever.
TOKEN_TTL_DAYS=30
