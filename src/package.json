{
	"name": "llmscheme",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build:core": "node scripts/build-skill.mjs --core-only",
		"build:app": "vite build",
		"build:skill": "node scripts/build-skill.mjs",
		"check": "node scripts/build-skill.mjs --check",
		"typecheck": "tsc -p core/tsconfig.json",
		"test": "node --test test/core.test.mjs",
		"test:update": "node --test --test-update-snapshots test/"
	},
	"devDependencies": {
		"@fontsource/press-start-2p": "5.3.0",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@types/node": "^22.20.1",
		"esbuild": "0.28.2",
		"svelte": "5.57.0",
		"typescript": "5.9.3",
		"vite": "8.2.2",
		"vite-plugin-singlefile": "2.3.3"
	}
}
